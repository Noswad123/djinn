set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

ui-package := "packages/opencode"
install-dir := env_var_or_default("DJINN_UI_INSTALL_DIR", env_var("HOME") + "/.local/bin")
required-bun := "1.3.14"

default:
    @just --list

# Build a native djinn-ui binary for the current machine.
build: check-bun
    bun install
    bun run --cwd {{ui-package}} script/build.ts --single --skip-embed-web-ui

# Ensure the Bun version supports packageManager. Older Bun releases do not
# understand this repo's workspace catalog dependencies.
check-bun:
    current="$(bun --version)"; version="${current%%-*}"; IFS=. read -r major minor patch <<< "${version}"; \
    if (( major < 1 || (major == 1 && minor < 3) || (major == 1 && minor == 3 && patch < 14) )); then \
      echo "djinn-ui requires Bun {{required-bun}} or newer; found ${current}" >&2; \
      echo "upgrade Bun before running: just install" >&2; \
      exit 1; \
    fi

# Build and install djinn-ui into ~/.local/bin, or DJINN_UI_INSTALL_DIR when set.
install: build
    install_dir="{{install-dir}}"; \
    case "$(uname -s)" in \
      Darwin) os=darwin ;; \
      Linux) os=linux ;; \
      *) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;; \
    esac; \
    case "$(uname -m)" in \
      arm64|aarch64) arch=arm64 ;; \
      x86_64|amd64) arch=x64 ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    binary="{{ui-package}}/dist/djinn-ui-${os}-${arch}/bin/djinn-ui"; \
    test -x "${binary}"; \
    mkdir -p "${install_dir}"; \
    install -m 0755 "${binary}" "${install_dir}/djinn-ui"; \
    "${install_dir}/djinn-ui" --version; \
    printf 'installed %s\n' "${install_dir}/djinn-ui"

# Remove the locally installed djinn-ui binary.
uninstall:
    rm -f "{{install-dir}}/djinn-ui"
    printf 'removed %s\n' "{{install-dir}}/djinn-ui"
